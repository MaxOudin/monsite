<nav class="fixed top-0 z-50 w-full backdrop-blur-sm bg-brand-bg/90 border-b border-gray-200 h-[52px] md:h-16" data-controller="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-[52px] md:h-16">
      <!-- Logo -->
      <%= link_to root_path, class: "flex-shrink-0 flex items-center" do %>
        <%= image_tag "yellow_logo.svg", class: "w-10 h-10 rounded-full", alt: "Logo Maxime Oudin - Développeur Ruby on Rails Bordeaux" %>
        <span class="hidden md:inline text-2xl text-gray-800 font-semibold ml-2">Maxime Oudin</span>
      <% end %>

      <!-- Boutons mobile (toggle thème + burger) -->
      <div class="md:hidden flex items-center gap-1">
        <button type="button"
                class="theme-toggle-btn"
                data-action="click->theme#toggle"
                aria-label="Changer de thème">
          <i class="fas fa-moon" data-theme-target="icon"></i>
        </button>
        <button type="button"
                class="p-2 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors"
                data-action="click->navbar#toggleMenu"
                aria-label="Menu">
          <i class="fas fa-bars text-xl"></i>
        </button>
      </div>

      <!-- Menu principal (desktop) -->
      <div class="hidden md:flex md:items-center md:space-x-8">
        <%= link_to "Projets", projets_path,
            class: "text-gray-700 hover:text-secondary px-3 py-2 rounded-md text-sm font-medium transition-colors duration-300 #{current_page?(projets_path) ? 'text-secondary font-semibold' : ''}" %>
        <%= link_to "Articles", articles_path,
            class: "text-gray-700 hover:text-secondary px-3 py-2 rounded-md text-sm font-medium transition-colors duration-300 #{current_page?(articles_path) ? 'text-secondary font-semibold' : ''}" %>

        <!-- Theme toggle (desktop) -->
        <button type="button"
                class="theme-toggle-btn"
                data-action="click->theme#toggle"
                aria-label="Changer de thème">
          <i class="fas fa-moon" data-theme-target="icon"></i>
        </button>

        <!-- CTA Desktop -->
        <div class="ml-4 flex items-center space-x-3">
          <%= render ButtonComponent.new(variant: :dark, size: :md) do %>
            <%= link_to "Contact", "#contact-infos", class: "text-white" %>
          <% end %>
          <% if user_signed_in? %>
            <%= button_to "Déconnexion", destroy_user_session_path, class: "inline-flex items-center justify-center rounded-lg font-semibold transition-all duration-200 px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 hover:bg-gray-50", 
                method: :delete, data: { turbo: false } %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Menu mobile (burger menu) -->
    <div class="md:hidden absolute top-full left-0 right-0 bg-white z-40 border-b border-gray-200 shadow-lg max-h-0 overflow-hidden transition-all duration-300 ease-in-out" 
         data-navbar-target="menu">
      <div class="flex flex-col px-6 py-4">
        <!-- Liens de navigation -->
        <%= link_to projets_path,
            class: "py-4 text-lg font-medium text-gray-900 border-b border-gray-200 hover:text-secondary transition-colors duration-300 #{current_page?(projets_path) ? 'text-secondary font-semibold' : ''}",
            data: { action: "click->navbar#closeMenu" } do %>
          Projets
        <% end %>

        <%= link_to articles_path,
            class: "py-4 text-lg font-medium text-gray-900 border-b border-gray-200 hover:text-secondary transition-colors duration-300 #{current_page?(articles_path) ? 'text-secondary font-semibold' : ''}",
            data: { action: "click->navbar#closeMenu" } do %>
          Articles
        <% end %>

        <a href="#contact-infos"
           class="py-4 text-lg font-medium text-gray-900 border-b border-gray-200 hover:text-secondary transition-colors duration-300"
           data-action="click->navbar#closeMenu">
          Contact
        </a>

        <!-- Déconnexion (si connecté) -->
        <% if user_signed_in? %>
          <div class="mt-4">
            <%= button_to 'Déconnexion', destroy_user_session_path, turbo_method: :delete,
                class: "w-full py-3 px-4 rounded-lg text-sm font-semibold text-gray-700 bg-gray-100 border border-gray-300 hover:bg-gray-200 transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <!-- Barre de progression de scroll -->
  <div class="absolute bottom-0 left-0 h-[2px] bg-primary origin-left"
       style="width: 0%"
       data-navbar-target="scrollProgress"></div>
</nav>

<!-- Spacer pour compenser la navbar fixe -->
<div class="h-[52px] md:h-16"></div>
