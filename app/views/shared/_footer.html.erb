<div class="footer-section">
  <div class="container footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="footer-logo">
          <span>Maxime Oudin</span>
        </div>
        <p class="footer-description">
          Développeur web indépendant spécialisé dans la création d'applications web modernes et performantes. Basé à Bordeaux, je travaille avec des clients dans toute la France.
        </p>
      </div>

      <div class="footer-services">
        <h4>Services</h4>
        <ul>
          <li>Développement Web</li>
          <li>Applications sur mesure</li>
          <li>Design Responsive</li>
          <li>Maintenance & Support</li>
        </ul>
      </div>

      <div class="footer-contact">
        <h4>Contact</h4>
        <div class="contact-info" id="contact-infos">
          <%= link_to "tel:+33664710483", class: "btn-contact" do %>
            <i class="fa-solid fa-phone"></i>
            <span>+33 6 64 71 04 83</span>
          <% end %>

          <%= link_to "mailto:contact@maximeoudin.fr", class: "btn-contact" do %>
            <i class="fa-solid fa-envelope"></i>
            <span>contact@maximeoudin.fr</span>
          <% end %>
        </div>
      </div>

      <div class="footer-social">
        <h4>Suivez-moi</h4>
        <div class="social-links">
          <a href="https://www.linkedin.com/in/maxime-oudin-developer/" 
             aria-label="Venez découvrir le profil LinkedIn de Maxime Oudin développeur web" 
             target="_blank"
             class="social-link linkedin">
            <i class="fab fa-linkedin"></i>
          </a>
          <a href="https://github.com/MaxOudin" 
             aria-label="Lien du Github de Maxime Oudin développeur web" 
             target="_blank"
             class="social-link github">
            <i class="fab fa-github"></i>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <p>&copy; <%= Date.today.year %> Maxime Oudin. Tous droits réservés.</p>
        <p>Développeur web Ruby on Rails à Bordeaux</p>
      </div>
      
      <div class="footer-legal">
        <%= link_to "Mentions légales", "#", aria_label: "Mentions légales", class: "nav-link-mentions" %>
        <%= link_to "Politique de confidentialité", "#", aria_label: "Politique de confidentialité", class: "nav-link-mentions" %>
      </div>
    </div>

    <div class="footer-carbon">
      <div id="wcb" class="carbonbadge wcb-d"></div>
      <script src="https://unpkg.com/website-carbon-badges@1.1.3/b.min.js" defer></script>
    </div>
  </div>
</div>
