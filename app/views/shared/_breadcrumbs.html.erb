<% if crumbs.present? %>
  <nav aria-label="Fil d'ariane" class="mb-4" data-controller="breadcrumbs">
    <ol class="flex items-center flex-wrap gap-3 text-xs font-medium uppercase tracking-[0.14em] text-gray-500">
      <% crumbs.each_with_index do |crumb, index| %>
        <li class="flex items-center gap-3 min-w-0">
          <% if index.positive? %>
            <span class="size-1.5 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
          <% end %>

          <% if crumb[:path].present? %>
            <%= link_to crumb[:name], crumb[:path],
                  class: "breadcrumb-link text-gray-500 hover:text-secondary transition-colors duration-300",
                  title: crumb[:name],
                  data: { breadcrumbs_target: "link" } %>
          <% else %>
            <span class="text-gray-900 normal-case tracking-normal truncate max-w-[16rem] sm:max-w-md"
                  title="<%= crumb[:name] %>"
                  aria-current="page">
              <%= crumb[:name] %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ol>

    <script type="application/ld+json">
      <%= breadcrumbs_structured_data(crumbs, request.original_url) %>
    </script>
  </nav>
<% end %>
