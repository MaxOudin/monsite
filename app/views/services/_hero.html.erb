<section class="relative isolate overflow-hidden bg-brand-bg min-h-[calc(100svh-4rem)] flex flex-col justify-center py-16 md:py-20 lg:py-24">

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 xl:gap-24 items-center">
      <div class="lg:col-span-7">
        <p class="hero-in-1 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-8 lg:mb-10">
          <span class="size-1.5 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
          Développeur web · Bordeaux
        </p>

        <h1 class="hero-in-2 text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-medium text-gray-900 tracking-tight leading-[1.08] mb-8">
          Je transforme vos idées en solutions web sur-mesure
        </h1>

        <p class="hero-in-3 text-base sm:text-lg text-gray-600 max-w-[46ch] leading-relaxed mb-10 lg:mb-12">
          Besoin d'un site web pour accroître votre visibilité
          ou d'un outil numérique pour améliorer votre productivité&nbsp;?
          Construisons ensemble votre projet.
        </p>

        <div class="hero-in-4 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8">
          <%= render ButtonComponent.new(
                variant: :primary,
                shape: :pill,
                size: :lg,
                href: "#contact-infos",
                html_options: {
                  data: { tally_open: "mB7p75", tally_hide_title: "1", tally_overlay: "1" },
                  title: "Contactez-moi pour votre projet web"
                }
              ) do %>
            Me contacter
          <% end %>

          <%= render ButtonComponent.new(
                variant: :link,
                size: :sm,
                href: projets_path,
                html_options: { title: "Découvrir mes projets Ruby on Rails" }
              ) do %>
            Voir mes réalisations
          <% end %>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <%= render "services/hero_stat",
                number: "#{@years_of_experience} ans",
                label: "d'expérience",
                icon: "fas fa-briefcase",
                extra_class: "hero-in-2" %>

            <%= render "services/hero_stat",
                number: "#{@articles_count}+",
                label: "Articles publiés",
                icon: "fas fa-pen-nib",
                path: articles_path,
                extra_class: "hero-in-4" %>
          </div>

          <div class="space-y-4 pt-8 sm:pt-12">
            <%= render "services/hero_stat",
                number: "100%",
                label: "Satisfaction client",
                icon: "fas fa-heart",
                featured: true,
                extra_class: "hero-in-3" %>

            <%= render "services/hero_stat",
                number: "#{@projets_count}+",
                label: "Projets réalisés",
                icon: "fas fa-layer-group",
                path: projets_path,
                extra_class: "hero-in-5" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
