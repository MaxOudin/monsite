<div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
  <div class="min-w-0">
    <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-4">
      <span class="size-1.5 rounded-full shrink-0" style="background-color: <%= @projet.couleur.presence || "#004AAD" %>" aria-hidden="true"></span>
      <%= @projet.type_projet.titleize %>
    </p>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-gray-900 tracking-tight leading-tight">
      <%= @projet.titre %>
    </h1>
  </div>

  <% if user_signed_in? %>
    <%= link_to "Modifier", edit_projet_path(@projet), class: "shrink-0 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors" %>
  <% end %>
</div>

<% if @projet.image_url.present? && valid_url_or_asset?(@projet.image_url) %>
  <div class="mb-10 rounded-2xl overflow-hidden bg-gray-100 border border-gray-200">
    <img src="<%= @projet.image_url %>"
         alt="<%= @projet.image_url_alt.presence || @projet.titre %>"
         class="w-full max-h-[32rem] object-contain"
         loading="lazy">
  </div>
<% end %>

<section class="mb-10" aria-labelledby="projet-contexte-title">
  <h2 id="projet-contexte-title" class="text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-4">
    Le contexte
  </h2>
  <dl class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <% if @projet.client.present? %>
      <div class="rounded-xl border border-gray-200 bg-white p-5">
        <dt class="text-sm text-gray-500">Client</dt>
        <dd class="mt-1 text-base font-medium text-gray-900"><%= @projet.client %></dd>
      </div>
    <% end %>

    <% if @projet.date_debut.present? %>
      <div class="rounded-xl border border-gray-200 bg-white p-5">
        <dt class="text-sm text-gray-500">Période</dt>
        <dd class="mt-1 text-base font-medium text-gray-900">
          <%= l(@projet.date_debut, format: :month_year) %>
          –
          <%= @projet.date_fin.present? ? l(@projet.date_fin, format: :month_year) : "En cours" %>
        </dd>
      </div>
    <% end %>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <dt class="text-sm text-gray-500">Type</dt>
      <dd class="mt-1 text-base font-medium text-gray-900"><%= @projet.type_projet.titleize %></dd>
    </div>
  </dl>
</section>

<% if @projet.description.present? %>
  <section class="mb-10" aria-labelledby="projet-description-title">
    <h2 id="projet-description-title" class="text-2xl font-medium text-gray-900 tracking-tight mb-4">
      Le projet
    </h2>
    <div class="text-base text-gray-700 leading-relaxed max-w-3xl">
      <%= simple_format(@projet.description) %>
    </div>
  </section>
<% end %>

<% if @projet.projet_lien.present? || @projet.github_lien.present? || @projet.outils.any? %>
  <section class="mb-4" aria-labelledby="projet-realisation-title">
    <h2 id="projet-realisation-title" class="text-2xl font-medium text-gray-900 tracking-tight mb-4">
      La réalisation
    </h2>

    <% if @projet.projet_lien.present? || @projet.github_lien.present? %>
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <% if @projet.projet_lien.present? %>
          <%= link_to @projet.projet_lien, target: "_blank", rel: "noopener", class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-gray-200 bg-white text-gray-800 hover:bg-gray-50 transition-colors" do %>
            <i class="fas fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
            Voir le projet
          <% end %>
        <% end %>

        <% if @projet.github_lien.present? %>
          <%= link_to @projet.github_lien, target: "_blank", rel: "noopener", class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-gray-200 bg-white text-gray-800 hover:bg-gray-50 transition-colors" do %>
            <i class="fab fa-github text-sm" aria-hidden="true"></i>
            Code source
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @projet.outils.any? %>
      <h3 class="text-sm font-medium text-gray-500 mb-3">Technologies</h3>
      <ul class="flex flex-wrap gap-2">
        <% @projet.outils.each do |outil| %>
          <li class="inline-flex items-center gap-2 rounded-lg bg-gray-50 border border-gray-200 px-3 py-2">
            <% if outil.icone_url.present? %>
              <img src="<%= outil.icone_url %>"
                   alt=""
                   class="w-5 h-5 object-contain">
            <% end %>
            <span class="text-sm font-medium text-gray-900"><%= outil.nom %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<nav class="mt-12 pt-8 border-t border-gray-200" aria-label="Autres projets">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% if @previous_projet.present? %>
      <%= link_to projet_path(@previous_projet), class: "group rounded-xl border border-gray-200 bg-white p-5 hover:border-secondary transition-colors" do %>
        <span class="block text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-2">Projet précédent</span>
        <span class="block text-base font-medium text-gray-900 group-hover:text-secondary transition-colors"><%= @previous_projet.titre %></span>
      <% end %>
    <% end %>

    <% if @next_projet.present? %>
      <%= link_to projet_path(@next_projet), class: "group rounded-xl border border-gray-200 bg-white p-5 hover:border-secondary transition-colors sm:text-right #{@previous_projet.present? ? '' : 'sm:col-start-2'}" do %>
        <span class="block text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-2">Projet suivant</span>
        <span class="block text-base font-medium text-gray-900 group-hover:text-secondary transition-colors"><%= @next_projet.titre %></span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "Retour aux projets", projets_path, class: "text-sm font-medium text-secondary hover:text-secondary-hover transition-colors" %>
  </div>
</nav>
