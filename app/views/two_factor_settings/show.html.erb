<div class="my-[5vh] mx-auto w-[90%] max-w-[800px] flex flex-col px-5 md:w-[95%] md:px-4">
  <h1 class="text-2xl font-bold mb-2 text-brand-text md:text-3xl">Double authentification</h1>
  <p class="mb-8 text-sm text-gray-600 md:text-base">
    Protégez votre compte avec une application d'authentification (Google Authenticator, 1Password, etc.).
  </p>

  <% if current_user.otp_required_for_login? %>
    <div class="mb-8 rounded-lg border border-green-200 bg-green-50 p-4 md:p-6">
      <p class="font-medium text-green-800">La double authentification est activée.</p>
    </div>

    <h2 class="text-xl font-semibold mb-4 text-brand-text">Désactiver</h2>
    <%= form_with url: two_factor_settings_path, method: :delete, local: true, class: "space-y-4 md:space-y-6", data: { turbo: false } do %>
      <div>
        <label for="password" class="block text-sm font-medium text-brand-text mb-2">Mot de passe</label>
        <input type="password" name="password" id="password" required autocomplete="current-password"
               class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 focus:outline-none">
      </div>
      <div>
        <label for="otp_attempt" class="block text-sm font-medium text-brand-text mb-2">Code 2FA ou code de secours</label>
        <input type="text" name="otp_attempt" id="otp_attempt" required autocomplete="one-time-code" inputmode="numeric"
               class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 focus:outline-none">
      </div>
      <button type="submit"
              class="w-full px-4 py-3 rounded-lg bg-red-600 text-white font-medium hover:bg-red-700 transition-colors md:w-auto">
        Désactiver le 2FA
      </button>
    <% end %>
  <% elsif @pending_setup %>
    <div class="mb-8 flex flex-col items-center gap-4 rounded-lg border border-gray-200 bg-white p-4 md:p-6">
      <p class="text-sm text-brand-text md:text-base text-center">
        Scannez ce QR code avec votre application d’authentification.
      </p>
      <div class="w-48 h-48 md:w-56 md:h-56 p-3 bg-white rounded-md [&_svg]:w-full [&_svg]:h-full">
        <%= otp_qr_svg(current_user) %>
      </div>
      <p class="text-xs text-gray-500 break-all text-center">
        Clé manuelle : <code class="font-mono"><%= current_user.otp_secret %></code>
      </p>
    </div>

    <h2 class="text-xl font-semibold mb-4 text-brand-text">Confirmer l’activation</h2>
    <%= form_with url: confirm_two_factor_settings_path, method: :post, local: true, class: "space-y-4", data: { turbo: false } do %>
      <div>
        <label for="otp_attempt" class="block text-sm font-medium text-brand-text mb-2">Code à 6 chiffres</label>
        <input type="text" name="otp_attempt" id="otp_attempt" required autocomplete="one-time-code" inputmode="numeric"
               class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 focus:outline-none"
               placeholder="123456">
      </div>
      <button type="submit"
              class="w-full px-4 py-3 rounded-lg bg-primary text-brand-text font-medium hover:bg-primary-hover transition-colors md:w-auto">
        Activer le 2FA
      </button>
    <% end %>
  <% else %>
    <div class="rounded-lg border border-gray-200 bg-white p-4 md:p-6">
      <p class="mb-4 text-sm text-brand-text md:text-base">
        La double authentification n’est pas encore activée.
      </p>
      <%= button_to "Configurer le 2FA", two_factor_settings_path, method: :post,
          class: "w-full px-4 py-3 rounded-lg bg-primary text-brand-text font-medium hover:bg-primary-hover transition-colors md:w-auto",
          data: { turbo: false } %>
    </div>
  <% end %>
</div>
