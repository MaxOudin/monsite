<div class="max-w-3xl mx-auto">
  <div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-4">
        <span class="inline-flex items-center gap-2">
          <span class="size-1.5 rounded-full shrink-0" style="background-color: <%= article.couleur_du_theme %>" aria-hidden="true"></span>
          <%= article.theme %>
        </span>
        <span aria-hidden="true">·</span>
        <time datetime="<%= article.created_at.to_date.iso8601 %>">
          <%= l(article.created_at.to_date, format: :long) %>
        </time>
        <span aria-hidden="true">·</span>
        <span><%= article.reading_time_in_minutes %> min de lecture</span>
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-gray-900 tracking-tight leading-tight">
        <%= article.titre %>
      </h1>
    </div>

    <% if user_signed_in? %>
      <%= link_to "Modifier", edit_article_path(article), class: "shrink-0 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors" %>
    <% end %>
  </div>

  <% if article.image_url.present? && valid_url_or_asset?(article.image_url) %>
    <div class="mb-10 rounded-2xl overflow-hidden bg-gray-100 border border-gray-200">
      <img src="<%= article.image_url %>"
           alt="<%= article.image_alt.presence || article.titre %>"
           class="w-full aspect-[16/9] object-cover"
           loading="lazy">
    </div>
  <% end %>

  <% if article.content.present? %>
    <div class="prose max-w-none text-base text-gray-700 leading-relaxed">
      <%= article.content %>
    </div>
  <% end %>
</div>

<% if @related_articles.present? %>
  <section class="mt-16 pt-10 border-t border-gray-200" aria-labelledby="related-articles-title">
    <h2 id="related-articles-title" class="text-2xl sm:text-3xl font-medium text-gray-900 tracking-tight mb-6">
      À lire ensuite
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <% @related_articles.each do |related| %>
        <%= render CardComponent.new(model: related) %>
      <% end %>
    </div>
  </section>
<% end %>
