<%= link_to card_path, class: "group block h-full rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2" do %>
  <article class="flex flex-col h-full overflow-hidden rounded-xl border border-gray-200 bg-white shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0">
    <div class="relative overflow-hidden aspect-[16/10] <%= has_custom_image? ? "bg-gray-100" : "bg-primary/10" %>">
      <img src="<%= image_src %>"
           alt="<%= image_alt %>"
           class="<%= has_custom_image? ? "h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100" : "h-full w-full object-contain p-10" %>"
           loading="lazy">
    </div>

    <div class="flex flex-1 flex-col p-5">
      <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.14em] text-gray-500 mb-3">
        <span><%= badge_text %></span>
        <span class="size-1 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
        <span><%= formatted_date %></span>
      </p>

      <h2 class="card-title text-xl font-bold text-gray-900 leading-snug transition-colors duration-300 group-hover:text-secondary line-clamp-2">
        <%= @model.titre %>
      </h2>

      <% if excerpt.present? %>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed line-clamp-2">
          <%= excerpt %>
        </p>
      <% end %>
    </div>
  </article>
<% end %>
